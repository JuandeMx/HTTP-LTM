<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sweep gradient for spinning effect -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:useLevel="false"
                android:startColor="#00FFEB3B"
                android:endColor="#FFFFEB3B"
                android:angle="0" />
        </shape>
    </item>
    <!-- Mask to turn it into a stroke -->
    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#0B0D11" />
        </shape>
    </item>
    <!-- Inner Dark Circle -->
    <item android:bottom="8dp" android:left="8dp" android:right="8dp" android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#1A1F26" />
        </shape>
    </item>
</layer-list>
